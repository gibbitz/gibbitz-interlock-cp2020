{{cp2020Log ' STATS | ' this}}
<div class="legend">Stats</div>
<article class="fieldset row">
  {{#each this}}
    {{cp2020Log ' STAT | ' @key}}
    <details class="edgerunner__stat stat--level-{{total}} col">
      <summary class="col">
        <h3 style="display: inline-block;">[{{abbr}}] {{total}}</h3>
        <progress max="10" value="{{total}}">{{total}}</progress>
        <small>[{{name}}]</small>
      </summary>
      <div class="row">
        {{cp2020-input
        label='cp2020.stats.base'
        name=(concat 'system.stats.' @key '.natural')
        type='number'
        value=natural
        }}
        {{cp2020-input
        label='cp2020.stats.mod'
        name=(concat 'system.stats.' @key '.modifier')
        type='number'
        value=modifier
        }}
      </div>
    </details>
  {{/each}}
</article>