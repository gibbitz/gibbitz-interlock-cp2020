{{cp2020Log ' ACTOR | ' actor}}
{{cp2020Log ' ACTOR-SHEET | ' this}}

<form class="edgerunner-sheet">

  <div class="row">
    <div class="col identity-col">
      <div class="row">
        <div class="col col-1">
          {{identity actor}}
          {{style actor}}
          {{values actor}}
        </div>
        <div class="col col-2">
          {{motivations actor}}
          {{bio actor.system.bio}}
        </div>
      </div>
    </div>
    <div class="col">
      {{portrait actor}}
      <div class="row">
        {{stat actor.system.stats}}
      </div>
    </div>
  </div>


  <hr />
  <h3>Armor</h3>
  <ul class="item-list">
    {{#each actor.system.armor }}
      {{outfit this}}
    {{/each}}
  </ul>

  <hr />
  <h3>Cyberdecks</h3>
  <ul class="item-list">
    {{#each actor.system.cyberdecks}}
      {{cyberdeck this}}
    {{/each}}
  </ul>

  <hr />
  <h3>Cyberwear</h3>
  <ul class="item-list">
    {{#each actor.system.cyberwear}}
      {{cyberwear this}}
    {{/each}}
  </ul>

  <hr />
  <h3>Outfit</h3>
  <ul class="item-list">
    {{#each actor.system.outfit}}
      {{outfit this}}
    {{/each}}
  </ul>

  <hr />
  <h3>Programs</h3>
  <ul class="item-list">
    {{#each actor.system.programs}}
      {{program this}}
    {{/each}}
  </ul>

  <hr />
  <h3>Skills</h3>
  <ul class="item-list">
    {{#each actor.itemTypes.skill}}
      {{skill skill=this index=@index}}
    {{/each}}
  </ul>

  <hr />
  <h3>Vehicles</h3>
  <ul class="item-list">
    {{#each actor.system.vehicles}}
      {{vehicle this}}
    {{/each}}
  </ul>

  <hr />
  <h3>Weapons</h3>
  <ul class="item-list">
    {{#each actor.system.weapons}}
      {{weapon this}}
    {{/each}}
  </ul>
</form>