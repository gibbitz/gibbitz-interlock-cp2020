{{!-- cssClass is "locked" for players, "editable" for GMs --}}
{{cp2020Log ' SKILL SHEET stat prop: | ' item}}
<form class="{{cssClass}}" autocomplete="off">
  <header class="legend">{{localize 'cp2020.items.skill.label'}}</header>
  <article class="fieldset">
    <aside>
      <div class="row">

      <div class="col">
        {{cp2020-input
          label="cp2020.items.skill.level"
          name="system.level"
          type='number'
          value=item.system.level
        }}
        {{cp2020-checkbox
          label="cp2020.items.skill.isChipped"
          name="system.isChipped"
          disabled=true
          value=item.system.isChipped
        }}
        {{cp2020-input
          label="cp2020.items.skill.chipLevel"
          name="system.chipLevel"
          type='number'
          value=item.system.chipLevel
        }}
      </div>
      <div class="col">
        {{cp2020-input
          label="cp2020.items.skill.ip"
          name="system.ip"
          type='number'
          value=item.system.ip
        }}
        {{cp2020-input
          label="cp2020.items.skill.ipMultiplier"
          name="system.ipMultiplier"
          type='number'
          value=item.system.ipMultiplier
        }}
        <label>{{localize "cp2020.items.skill.levelUp"}}</label>
        {{item.system.levelUp}}
      </div>
      </div>
    </aside>
    {{cp2020-input
      label="cp2020.items.skill.flavor"
      name="name"
      type='text'
      value=item.name
    }}
    {{cp2020-select
      label="cp2020.items.skill.stat"
      name="system.stat"
      value=item.system.stat
      options=STAT_SELECT_OPTIONS
    }}

    {{cp2020-textarea
      label="cp2020.items.skill.description"
      name="system.description"
      value=item.system.description
    }}
    {{cp2020-textarea
      label="cp2020.items.skill.notes"
      name="system.notes"
      value=item.system.notes
    }}
    </div>
  </article>
</form>