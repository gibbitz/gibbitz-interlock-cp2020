{{cp2020Log ' VEHICLE SHEET | ' this}}
<form class="flexcol {{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <h1>{{localize 'cp2020.items.vehicle.label'}}</h1>
  </header>
  <article>
    <aside>
      <div>
        {{cp2020-input
        label="cp2020.items.name"
        name="name"
        type='text'
        value=item.name
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cost"
        name="system.cost"
        type='number'
        value=item.system.cost
        }}
      </div>
      <div>
        {{cp2020-select
        label="cp2020.items.availabilities.label"
        name="system.availability"
        value=item.system.availability
        options=ITEM_AVAILABILITIES_SELECT_OPTIONS
        }}
      </div>
      <div>
        {{cp2020-textarea
        label="cp2020.items.description"
        name="system.description"
        value=item.system.description
        }}
      </div>
      <div>
        {{cp2020-checkbox
        label="cp2020.items.equipped"
        name="system.equipped"
        value=item.system.equipped
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.acc.long"
        name="system.acceleration"
        type='number'
        value=item.system.acceleration
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.dec.long"
        name="system.deceleration"
        type='number'
        value=item.system.deceleration
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.crew"
        name="system.crew"
        type='number'
        value=item.system.crew
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.passengers.long"
        name="system.passengers"
        type='number'
        value=item.system.passengers
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.range"
        name="system.range"
        type='number'
        value=item.system.range
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.cargo"
        name="system.cargo"
        type='number'
        value=item.system.cargo
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.maneuver.long"
        name="system.maneuver"
        type='number'
        value=item.system.maneuver
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.vehicle.topSpeed.long"
        name="system.topSpeed"
        type='number'
        value=item.system.topSpeed
        }}
      </div>
    </aside>
  </article>
</form>