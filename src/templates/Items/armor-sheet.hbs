{{cp2020Log ' ARMOR SHEET | ' this}}
<form autocomplete="off" class="{{SYSTEM_NAME}}-armor-sheet {{cssClass}}">
  <header class="sheet-header legend">{{localize 'cp2020.items.armor.label'}}</header>
  <article class="fieldset">
    <div class="row">
      <div class="col">
        {{cp2020-input
        label="cp2020.items.name"
        name="name"
        type='text'
        value=item.name
        }}
        {{cp2020-input
        label="cp2020.items.armor.sp.long"
        name="system.sp"
        type='number'
        value=item.system.sp
        }}
        {{cp2020-input
        label="cp2020.items.armor.ev.long"
        name="system.ev"
        type='number'
        value=item.system.ev
        }}
        {{cp2020-select
        label="cp2020.items.availabilities.label"
        name="system.availability"
        value=item.system.availability
        options=ITEM_AVAILABILITIES_SELECT_OPTIONS
        }}
        {{cp2020-input
        label="cp2020.items.cost"
        name="system.cost"
        type='number'
        value=item.system.cost
        }}
        {{cp2020-textarea
        label="cp2020.items.description"
        name="system.description"
        value=item.system.description
        }}
      </div>
      <div class="col mannequin-col">
        <figure class="mannequin {{locationClasses}}">
          {{{graphic}}}
        </figure>
          {{cp2020-select
          label="cp2020.items.cyberwear.location.long"
          name="system.locations"
          value=item.system.locations
          options=LOCATION_SELECT_OPTIONS
          multiple=true
          }}
      </div>
    </div>
  </article>
</form>