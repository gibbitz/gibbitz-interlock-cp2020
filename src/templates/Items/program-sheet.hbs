{{cp2020Log ' PROGRAM SHEET | ' this}}
<form class="flexcol {{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <h1>{{localize 'cp2020.items.program.label'}}</h1>
  </header>
  <article>
    <aside>
      <div>
        {{cp2020-input
        label="cp2020.items.name"
        name="name"
        type='text'
        value=item.name
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cost"
        name="system.cost"
        type='number'
        value=item.system.cost
        }}
      </div>
      <div>
        {{cp2020-select
        label="cp2020.items.availabilities.label"
        name="system.availability"
        value=item.system.availability
        options=ITEM_AVAILABILITIES_SELECT_OPTIONS
        }}
      </div>
      <div>
        {{cp2020-textarea
        label="cp2020.items.description"
        name="system.description"
        value=item.system.description
        }}
      </div>
      <div>
        {{cp2020-checkbox
        label="cp2020.items.equipped"
        name="system.equipped"
        value=item.system.equipped
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.program.strength.long"
        name="system.strength"
        type='number'
        value=item.system.strength
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.program.memoryUnits.long"
        name="system.memoryUnits"
        type='number'
        value=item.system.memoryUnits
        }}
      </div>
    </aside>
  </article>
</form>