{{cp2020Log ' CYBERWEAR SHEET | ' this}}
<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <h1>{{localize 'cp2020.items.cyberwear.label'}}</h1>
  </header>
  <article>
    <aside>
      <div></div>
      <div>
        {{cp2020-input
        label="cp2020.items.name"
        name="name"
        type='text'
        value=item.name
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cost"
        name="system.cost"
        type='number'
        value=item.system.cost
        }}
      </div>
      <div>
        {{cp2020-select
        label="cp2020.items.availabilities.label"
        name="system.availability"
        value=item.system.availability
        options=ITEM_AVAILABILITIES_SELECT_OPTIONS
        }}
      </div>
      <div>
        {{cp2020-textarea
        label="cp2020.items.description"
        name="system.description"
        value=item.system.description
        }}
      </div>
      <div>
        {{cp2020-checkbox
        label="cp2020.items.equipped"
        name="system.equipped"
        value=item.system.equipped
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberwear.humanityCost.long"
        name="system.humanityCost"
        type='text'
        value=item.system.humanityCost
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberwear.humanityLoss.long"
        name="system.humanityLoss"
        type='number'
        value=item.system.humanityLoss
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberwear.surgicalCost.long"
        name="system.surgicalCost"
        type='text'
        value=item.system.surgicalCost
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberwear.slots"
        name="system.slots"
        type='number'
        value=item.system.slots
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberwear.modifier"
        name="system.modifier"
        type='number'
        value=item.system.modifier
        }}
      </div>
      <div>
        {{cp2020-select
        label="cp2020.items.cyberwear.modifierType"
        name="system.modifierType"
        value=item.system.modifierType
        options=CYBERWEAR_MODIFIER_TYPE_SELECT_OPTIONS
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberwear.modifies"
        name="system.modifies"
        type='text'
        value=item.system.modifies
        }}
      </div>
      <div>
        {{cp2020-select
        label="cp2020.items.cyberwear.location.long"
        name="system.location"
        value=item.system.location
        options=LOCATION_SELECT_OPTIONS
        }}
      </div>
      <div>
        {{cp2020-select
        label="cp2020.items.weapon.type.long"
        name="system.type"
        value=item.system.type
        options=WEAPON_TYPE_SELECT_OPTIONS
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.skill"
        name="system.skill"
        type='text'
        value=item.system.skill
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.damage.long"
        name="system.damage"
        type='text'
        value=item.system.damage
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.accuracy.long"
        name="system.accuracy"
        type='number'
        value=item.system.accuracy
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.range"
        name="system.range"
        type='number'
        value=item.system.range
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.magazine.long"
        name="system.magazine"
        type='number'
        value=item.system.magazine
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.cartridge.long"
        name="system.cartridge"
        type='text'
        value=item.system.cartridge
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.rateOfFire.long"
        name="system.rateOfFire"
        type='number'
        value=item.system.rateOfFire
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weapon.blastRadius.long"
        name="system.blastRadius"
        type='number'
        value=item.system.blastRadius
        }}
      </div>
    </aside>
  </article>
</form>