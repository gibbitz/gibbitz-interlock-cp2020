{{cp2020Log ' CYBERDECK SHEET | ' this}}
<form class="{{cssClass}}" autocomplete="off">
  <header class="sheet-header">
    <h1>{{localize 'cp2020.items.cyberdeck.label'}}</h1>
  </header>
  <article>
    <aside>
      <div></div>
      <div>
        {{cp2020-input
        label="cp2020.items.name"
        name="name"
        type='text'
        value=item.name
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cost"
        name="system.cost"
        type='number'
        value=item.system.cost
        }}
      </div>
      <div>
        {{cp2020-select
        label="cp2020.items.availabilities.label"
        name="system.availability"
        value=item.system.availability
        options=ITEM_AVAILABILITIES_SELECT_OPTIONS
        }}
      </div>
      <div>
        {{cp2020-textarea
        label="cp2020.items.description"
        name="system.description"
        value=item.system.description
        }}
      </div>
      <div>
        {{cp2020-checkbox
        label="cp2020.items.equipped"
        name="system.equipped"
        value=item.system.equipped
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.weight"
        name="system.weight"
        type='number'
        value=item.system.weight
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberdeck.cpu.long"
        name="system.cpu"
        type='number'
        value=item.system.cpu
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberdeck.dataWalls.long"
        name="system.dataWallStr"
        type='number'
        value=item.system.dataWallStr
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberdeck.codeGates.long"
        name="system.codeGateStr"
        type='number'
        value=item.system.codeGateStr
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberdeck.speed.long"
        name="system.speed"
        type='number'
        value=item.system.speed
        }}
      </div>
      <div>
        {{cp2020-input
        label="cp2020.items.cyberdeck.memory.long"
        name="system.memoryUnits"
        type='number'
        value=item.system.memoryUnits
        }}
      </div>
    </aside>
  </article>
</form>