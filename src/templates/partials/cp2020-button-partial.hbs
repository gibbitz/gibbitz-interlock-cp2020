<span class="field-button--wrapper {{#if class}}{{class}}{{/if}}">
  <input
    type="button"
    value="{{localize label}}"
    class="{{class}}"
    data-action="{{action}}"
    data-flavor="{{flavor}}"
    data-selector="{{selector}}"
    data-uuid="{{uuid}}"
    data-key="{{key}}"
    data-meta="{{meta}}"
    data-render="{{render}}"
    {{#if roll}}data-roll{{/if}}
  />
</span>