<span class="field-box">
  <span class="field-box--inner">
    <label>
      <input
        name="{{name}}"
        value="{{value}}"
        type="{{type}}"
        data-selector="{{selector}}"
        data-id="{{uuid}}"
        data-key="{{key}}"
        data-render="{{render}}"
      />
      <small>{{localize label}}</small>
    </label>
  </span>
</span>