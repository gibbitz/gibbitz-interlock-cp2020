{{systemLog ' OFFENSE DIALOG: |' this }}
{{!-- output weapon data --}}
{{!-- determine available attack types --}}
{{#if isMelee}}

{{/if}}
{{!-- select attack type --}}
{{!-- display relevant selections --}}
<form data-selector="defenseValues">
  {{cp2020-input
    label="first test"
    name="offense-hbs-input-number"
    type='number'
  }}
  {{cp2020-input
    label="second test"
    name="offense-hbs-input"
    type='text'
  }}
  {{!-- display for <3 rounds of fire --}}
  {{#if multipleTargets}}
    {{cp2020-select
      label="cp2020.dialogs.checks.selects.target.label"
      name="targetActorId"
      inverted=true
      options=targetOptions
    }}
  {{else}}
    {{cp2020-input
      name="targetActorId"
      type='hidden'
      value=targetActorId
    }}
  {{/if}}
</form>